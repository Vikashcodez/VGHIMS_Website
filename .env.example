# ==========================================
# VGHIMS - SMTP Server Configuration
# ==========================================

# Server Port
PORT=5000

# ------------------------------------------
# SMTP Server Details
# ------------------------------------------
# For Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   (Note: Use a Gmail "App Password", not your normal Google password)
#
# For Office 365 / Outlook:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#
# For Custom Domain / cPanel / Webmail (e.g., VoiceGate):
#   SMTP_HOST=mail.voicegateindia.com
#   SMTP_PORT=465 (or 587)
#   SMTP_SECURE=true (if using 465, false if 587)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Your SMTP sender email credentials
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password_or_app_password

# The destination email address where demo booking notifications should be delivered
RECEIVER_EMAIL=info@voicegateindia.com

